# ==============================================================================
# CONFIGURATION ENVIRONNEMENT - FERTILITE APP BACKEND
# ==============================================================================

NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# 1. OPTION A : POSTGRESQL EN LOCAL (Docker ou installation locale)
# ------------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=fertidb
DATABASE_SSL=false

# ------------------------------------------------------------------------------
# 2. OPTION B : NEON POSTGRESQL EN LIGNE (Décommenter et renseigner votre URL)
# Si DATABASE_URL est renseigné, il prend la priorité sur DATABASE_HOST/USER/etc.
# Le SSL (rejectUnauthorized: false) est activé automatiquement pour Neon.
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://<user>:<password>@<ep-nom-instance>.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# AUTHENTIFICATION & SÉCURITÉ
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_pour_developpement_local_min_32_chars
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=super_secret_refresh_token_key_pour_developpement_local
REFRESH_TOKEN_EXPIRATION=30d

# ------------------------------------------------------------------------------
# PAIEMENT FEDAPAY (Agrégateur MTN MoMo, Moov Money, Celtiis Cash, Visa/Mastercard)
# ------------------------------------------------------------------------------
FEDAPAY_SECRET_KEY=sk_sandbox_your_secret_key
FEDAPAY_PUBLIC_KEY=pk_sandbox_your_public_key
FEDAPAY_ENVIRONMENT=sandbox # ou 'live' en production
FEDAPAY_CALLBACK_URL=https://fertilitebackend.onrender.com/api/v1/subscriptions/payment/fedapay-webhook

# ------------------------------------------------------------------------------
# BACK-OFFICE SUPER ADMIN (Pilotage de l'exigence d'abonnement)
# ------------------------------------------------------------------------------
SUPER_ADMIN_API_KEY=remplacer_par_une_cle_super_admin_longue_et_securisee
